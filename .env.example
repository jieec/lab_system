# 复制为 .env 后按需修改：cp .env.example .env
# Docker Compose 会自动读取同目录下的 .env

# MySQL root 密码（容器内数据库；与本机已装的 MySQL 无关）
MYSQL_PASSWORD=lab123456
# 宿主机映射端口
MYSQL_HOST_PORT=3307
BACKEND_PORT=8080
FRONTEND_PORT=8081
# 生产/公开展示环境务必改成随机长字符串
JWT_SECRET=lab-reservation-system-secret-key-2026-please-change

# 智能助手：留空可使用规则演示模式；Key只由后端读取
LLM_ENABLED=true
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
