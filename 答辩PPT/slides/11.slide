<Slide style={{ width: 1280, height: 720, padding: 0, flexDirection: 'column', background: '#FFFFFF', overflow: 'hidden' }}>

    <Box style={{ height: 52, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40 }}>
        <Text style={{ fontSize: 15, color: '#FFFFFF', letterSpacing: 1 }}>高校实验室预约与设备运维系统</Text>
        <Text style={{ fontSize: 15, color: '#9FBCE8', letterSpacing: 1 }}>03　实现与测试</Text>
    </Box>

    <Box style={{ paddingLeft: 40, paddingRight: 40, paddingTop: 12 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C', letterSpacing: 0.5 }}>预约模块：从选实验室到冲突提示</Text>
            <Text style={{ fontSize: 14, color: '#8B97A8' }}>学生视角 · 真实运行界面</Text>
        </Box>
        <Box style={{ width: 56, height: 3, background: '#1E4FA8', marginTop: 8 }} />
    </Box>

    <Box style={{ flex: 1, flexDirection: 'row', gap: 24, paddingLeft: 40, paddingRight: 40, paddingTop: 12, paddingBottom: 10 }}>

        {/* 左：截图 */}
        <Box style={{ width: 700, flexDirection: 'column' }}>
            <Box style={{ width: 700, height: 486, border: '1px solid #C9CFDA', background: '#F7F9FC' }}>
                <Image src="assets/shot_reserve_dialog.png" style={{ width: '100%', height: '100%', objectFit: 'contain' }} />
            </Box>
            <Text style={{ fontSize: 14, color: '#8B97A8', marginTop: 8 }}>实验室列表 · 预约弹窗（已选日期后回填当日占用时段）</Text>
        </Box>

        {/* 右：说明 */}
        <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'space-between' }}>

            <Box style={{ flexDirection: 'column', gap: 16 }}>
                <Box style={{ flexDirection: 'row', gap: 12 }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', background: '#1E4FA8', width: 24, height: 24, textAlign: 'center' }}>1</Text>
                    <Box style={{ flexDirection: 'column', flex: 1 }}>
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C' }}>卡片直接给出决策信息</Text>
                        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.55, marginTop: 4 }}>容量、开放时段、今日已约次数、「需审批」标记，学生不必点进去试。</Text>
                    </Box>
                </Box>

                <Box style={{ flexDirection: 'row', gap: 12 }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', background: '#1E4FA8', width: 24, height: 24, textAlign: 'center' }}>2</Text>
                    <Box style={{ flexDirection: 'column', flex: 1 }}>
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C' }}>占用时段前置到弹窗内</Text>
                        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.55, marginTop: 4 }}>选日期即回填当日已被占用的时间段，冲突在提交之前就能看见。</Text>
                    </Box>
                </Box>

                <Box style={{ flexDirection: 'row', gap: 12 }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', background: '#1E4FA8', width: 24, height: 24, textAlign: 'center' }}>3</Text>
                    <Box style={{ flexDirection: 'column', flex: 1 }}>
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C' }}>四项后端校验兜底</Text>
                        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.55, marginTop: 4 }}>时长 30 分钟–8 小时 · 提前不超过 30 天 · 落在开放时段 · 容量与区间冲突。</Text>
                    </Box>
                </Box>

                <Box style={{ flexDirection: 'row', gap: 12 }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', background: '#1E4FA8', width: 24, height: 24, textAlign: 'center' }}>4</Text>
                    <Box style={{ flexDirection: 'column', flex: 1 }}>
                        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0E3F8C' }}>按实验室决定是否走审批</Text>
                        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.55, marginTop: 4 }}>need_approval = 0 直接置为已批准，否则进入待审批，由教师处理。</Text>
                    </Box>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'column', background: '#0E3F8C', paddingTop: 14, paddingBottom: 14, paddingLeft: 18, paddingRight: 18 }}>
                <Text style={{ fontSize: 12, color: '#9FBCE8', letterSpacing: 1 }}>库内真实分布 · 384 条预约</Text>
                <Box style={{ flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', marginTop: 8 }}>
                    <Box style={{ flexDirection: 'column' }}>
                        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#FFFFFF' }}>256</Text>
                        <Text style={{ fontSize: 12, color: '#9FBCE8' }}>已完结</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column' }}>
                        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#FFFFFF' }}>54</Text>
                        <Text style={{ fontSize: 12, color: '#9FBCE8' }}>已批准</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column' }}>
                        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#FFC107' }}>24</Text>
                        <Text style={{ fontSize: 12, color: '#9FBCE8' }}>待审批</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column' }}>
                        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#FFFFFF' }}>37</Text>
                        <Text style={{ fontSize: 12, color: '#9FBCE8' }}>已取消</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column' }}>
                        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#D9534F' }}>13</Text>
                        <Text style={{ fontSize: 12, color: '#9FBCE8' }}>已驳回</Text>
                    </Box>
                </Box>
            </Box>

        </Box>

    </Box>

    <Box style={{ height: 44, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40 }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>计算机科学与技术学院 · 毕业设计答辩</Text>
        <Text style={{ fontSize: 15, color: '#0E3F8C', fontWeight: 'bold' }}>11 / 14</Text>
    </Box>
</Slide>
