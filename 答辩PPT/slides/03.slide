<Slide style={{ width: 1280, height: 720, padding: 0, flexDirection: 'row', background: '#F7F9FC', overflow: 'hidden' }}>

    <Box style={{ width: 14, height: 720, background: '#0E3F8C' }} />

    <Box style={{ flex: 1, height: 720, flexDirection: 'column', justifyContent: 'space-between', paddingTop: 60, paddingBottom: 58, paddingLeft: 68, paddingRight: 68 }}>

        <Box style={{ flexDirection: 'column' }}>

            <Box style={{ flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
                <Box style={{ flexDirection: 'column', paddingBottom: 10 }}>
                    <Text style={{ fontSize: 15, color: '#1E4FA8', letterSpacing: 4 }}>第 一 章</Text>
                    <Text style={{ fontSize: 44, fontWeight: 'bold', color: '#0E3F8C', marginTop: 10, letterSpacing: 1 }}>背景与需求分析</Text>
                    <Box style={{ width: 72, height: 3, background: '#3D7BD9', marginTop: 18 }} />
                    <Text style={{ fontSize: 15, color: '#8B97A8', marginTop: 12, letterSpacing: 0.5 }}>P04 — P05　·　共 2 页　·　约 2 分钟</Text>
                </Box>
                <Text style={{ fontSize: 208, fontWeight: 'bold', color: '#C3D6EF', lineHeight: 0.82, letterSpacing: -6 }}>01</Text>
            </Box>

            <Box style={{ flexDirection: 'column', gap: 18, marginTop: 34 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
                    <Box style={{ width: 26, height: 26, background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 13, color: '#FFFFFF', fontWeight: 'bold' }}>1</Text>
                    </Box>
                    <Text style={{ fontSize: 21, color: '#1A2230', lineHeight: 1.55, width: 1090 }}>
                        <span style={{ fontWeight: 'bold', color: '#0E3F8C' }}>痛点从哪来：</span>预约靠群聊接龙与 Excel 登记，报修走纸质单——两条流程各自为政，冲突只能事后扯皮。
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
                    <Box style={{ width: 26, height: 26, background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 13, color: '#FFFFFF', fontWeight: 'bold' }}>2</Text>
                    </Box>
                    <Text style={{ fontSize: 21, color: '#1A2230', lineHeight: 1.55, width: 1090 }}>
                        <span style={{ fontWeight: 'bold', color: '#0E3F8C' }}>谁在用：</span>学生、教师、维修员、管理员四类角色，权限边界必须清晰，且落在接口层。
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
                    <Box style={{ width: 26, height: 26, background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 13, color: '#FFFFFF', fontWeight: 'bold' }}>3</Text>
                    </Box>
                    <Text style={{ fontSize: 21, color: '#1A2230', lineHeight: 1.55, width: 1090 }}>
                        <span style={{ fontWeight: 'bold', color: '#0E3F8C' }}>做到哪为止：</span>只收敛「预约排期」与「设备运维」两条主线，不涉及排课系统与门禁硬件对接。
                    </Text>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'row', gap: 16, marginTop: 26 }}>
                <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 12, background: '#FFFFFF', border: '1px solid #D6DCE5', paddingTop: 12, paddingBottom: 12, paddingLeft: 14, paddingRight: 14 }}>
                    <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#FFFFFF', background: '#1E4FA8', paddingLeft: 7, paddingRight: 7, paddingTop: 3, paddingBottom: 3 }}>P04</Text>
                    <Box style={{ flexDirection: 'column', flex: 1 }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1A2230' }}>选题背景：两条线下流程的失效点</Text>
                        <Text style={{ fontSize: 13, color: '#8B97A8', marginTop: 3 }}>预约冲突不可见 · 责任链断裂</Text>
                    </Box>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 12, background: '#FFFFFF', border: '1px solid #D6DCE5', paddingTop: 12, paddingBottom: 12, paddingLeft: 14, paddingRight: 14 }}>
                    <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#FFFFFF', background: '#1E4FA8', paddingLeft: 7, paddingRight: 7, paddingTop: 3, paddingBottom: 3 }}>P05</Text>
                    <Box style={{ flexDirection: 'column', flex: 1 }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1A2230' }}>需求分析：四类角色、四大功能域</Text>
                        <Text style={{ fontSize: 13, color: '#8B97A8', marginTop: 3 }}>功能结构图 · 权限边界</Text>
                    </Box>
                </Box>
            </Box>

        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 18, background: '#0E3F8C', paddingTop: 18, paddingBottom: 18, paddingLeft: 24, paddingRight: 24 }}>
            <Box style={{ width: 3, height: 40, background: '#3D7BD9' }} />
            <Text style={{ fontSize: 19, color: '#FFFFFF', lineHeight: 1.6, flex: 1 }}>
                需求不是想出来的——是从 <span style={{ fontWeight: 'bold', color: '#FFC107' }}>12 间实验室</span> 的排期冲突与 <span style={{ fontWeight: 'bold', color: '#FFC107' }}>237 台设备</span> 的报修记录里长出来的。
            </Text>
        </Box>

    </Box>
</Slide>
