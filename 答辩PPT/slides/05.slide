<Slide style={{ width: 1280, height: 720, padding: 0, flexDirection: 'column', background: '#FFFFFF', overflow: 'hidden' }}>

    <Box style={{ height: 52, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40 }}>
        <Text style={{ fontSize: 15, color: '#FFFFFF', letterSpacing: 1 }}>高校实验室预约与设备运维系统</Text>
        <Text style={{ fontSize: 15, color: '#9FBCE8', letterSpacing: 1 }}>01　背景与需求分析</Text>
    </Box>

    <Box style={{ paddingLeft: 40, paddingRight: 40, paddingTop: 14 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C', letterSpacing: 0.5 }}>需求分析：四类角色、四大功能域</Text>
            <Text style={{ fontSize: 14, color: '#8B97A8' }}>功能边界由角色决定，权限由接口兜底</Text>
        </Box>
        <Box style={{ width: 56, height: 3, background: '#1E4FA8', marginTop: 10 }} />
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', paddingLeft: 40, paddingRight: 40, paddingTop: 12, paddingBottom: 10 }}>

        <Box style={{ width: 1200, height: 213, border: '1px solid #D6DCE5', background: '#FFFFFF' }}>
            <Image src="assets/fig_func.png" style={{ width: '100%', height: '100%', objectFit: 'contain' }} />
        </Box>

        <Box style={{ flexDirection: 'row', gap: 14, marginTop: 10, height: 248 }}>

            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: 16, justifyContent: 'space-between' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C' }}>学生</Text>
                    <Box style={{ background: '#E8EFF8', paddingLeft: 7, paddingRight: 7, paddingTop: 2, paddingBottom: 2 }}>
                        <Text style={{ fontSize: 12, color: '#1E4FA8', fontWeight: 'bold' }}>24 人</Text>
                    </Box>
                </Box>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.55 }}>浏览实验室与设备，按起止时间提交预约，发起设备报修并跟踪进度。</Text>
                <Box style={{ flexDirection: 'column', gap: 5 }}>
                    <Text style={{ fontSize: 12, color: '#8B97A8' }}>可见范围</Text>
                    <Text style={{ fontSize: 14, color: '#1A2230' }}>仅本人预约与工单</Text>
                </Box>
                <Text style={{ fontSize: 13, color: '#1E4FA8', fontWeight: 'bold' }}>预约 · 报修 · 通知</Text>
            </Box>

            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: 16, justifyContent: 'space-between' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C' }}>教师</Text>
                    <Box style={{ background: '#E8EFF8', paddingLeft: 7, paddingRight: 7, paddingTop: 2, paddingBottom: 2 }}>
                        <Text style={{ fontSize: 12, color: '#1E4FA8', fontWeight: 'bold' }}>8 人</Text>
                    </Box>
                </Box>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.55 }}>在学生能力之上，审批所辖实验室的预约申请，填写通过或驳回意见。</Text>
                <Box style={{ flexDirection: 'column', gap: 5 }}>
                    <Text style={{ fontSize: 12, color: '#8B97A8' }}>审批范围</Text>
                    <Text style={{ fontSize: 14, color: '#1A2230' }}>限于本人负责的实验室</Text>
                </Box>
                <Text style={{ fontSize: 13, color: '#1E4FA8', fontWeight: 'bold' }}>预约 · 审批 · 报修</Text>
            </Box>

            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: 16, justifyContent: 'space-between' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C' }}>维修员</Text>
                    <Box style={{ background: '#E8EFF8', paddingLeft: 7, paddingRight: 7, paddingTop: 2, paddingBottom: 2 }}>
                        <Text style={{ fontSize: 12, color: '#1E4FA8', fontWeight: 'bold' }}>3 人</Text>
                    </Box>
                </Box>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.55 }}>接收派单、开始维修、填写维修记录与费用，等待报修人验收确认。</Text>
                <Box style={{ flexDirection: 'column', gap: 5 }}>
                    <Text style={{ fontSize: 12, color: '#8B97A8' }}>不可为</Text>
                    <Text style={{ fontSize: 14, color: '#1A2230' }}>自行派单、验收自修工单</Text>
                </Box>
                <Text style={{ fontSize: 13, color: '#1E4FA8', fontWeight: 'bold' }}>接单 · 维修 · 完工</Text>
            </Box>

            <Box style={{ flex: 1, background: '#F0F5FC', border: '1px solid #C3D6EF', padding: 16, justifyContent: 'space-between' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C' }}>管理员</Text>
                    <Box style={{ background: '#0E3F8C', paddingLeft: 7, paddingRight: 7, paddingTop: 2, paddingBottom: 2 }}>
                        <Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 'bold' }}>1 人</Text>
                    </Box>
                </Box>
                <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.55 }}>维护实验室、设备台账与用户账号，配置开放时段与是否需审批。</Text>
                <Box style={{ flexDirection: 'column', gap: 5 }}>
                    <Text style={{ fontSize: 12, color: '#8B97A8' }}>受保护</Text>
                    <Text style={{ fontSize: 14, color: '#1A2230' }}>不能删除或停用自身</Text>
                </Box>
                <Text style={{ fontSize: 13, color: '#1E4FA8', fontWeight: 'bold' }}>全域配置 · 看板</Text>
            </Box>

        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: '#E8EFF8', paddingTop: 10, paddingBottom: 10, paddingLeft: 18, paddingRight: 18, marginTop: 12 }}>
            <Box style={{ width: 3, height: 26, background: '#1E4FA8' }} />
            <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.4, flex: 1 }}>
                权限落在接口层：自定义 <span style={{ fontWeight: 'bold', color: '#0E3F8C' }}>@RequireRole</span> 注解 + 拦截器统一校验，越权请求直接返回 403，而非仅隐藏菜单。
            </Text>
        </Box>

    </Box>

    <Box style={{ height: 44, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40 }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>计算机科学与技术学院 · 毕业设计答辩</Text>
        <Text style={{ fontSize: 15, color: '#0E3F8C', fontWeight: 'bold' }}>05 / 14</Text>
    </Box>
</Slide>
